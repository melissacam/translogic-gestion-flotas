{
  "name": "translogic-backend",
  "version": "0.0.1",
  "description": "API REST TRANSLOGIC S.A. — gestión de flotas, servicios y facturación",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "oxlint src/ test/ scripts/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "test:cov": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --coverage",
    "migrate:up": "migrate-mongo up -f migrations/migrate-mongo-config.js",
    "migrate:down": "migrate-mongo down -f migrations/migrate-mongo-config.js",
    "migrate:status": "migrate-mongo status -f migrations/migrate-mongo-config.js",
    "migrate:down-all": "node migrations/down-todo.js",
    "seed": "ts-node -r tsconfig-paths/register src/seed/seed.ts",
    "db:reset": "npm run migrate:down-all && npm run migrate:up && npm run seed",
    "openapi": "ts-node -r tsconfig-paths/register scripts/exportar-openapi.ts",
    "flujo:demo": "ts-node scripts/flujo-e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "joi": "^18.3.1",
    "luxon": "^3.7.2",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.11.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.0.0",
    "jest": "^30.5.2",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!seed/**",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
