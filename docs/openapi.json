              "minimum": 1,
              "example": 1,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "example": 10,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          },
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PROGRAMADO",
                "EN_EJECUCION",
                "COMPLETADO",
                "CANCELADO"
              ]
            }
          },
          {
            "name": "clienteId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vehiculoId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tipoVehiculo",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CAMION_CARGA",
                "FURGONETA_ELECTRICA"
              ]
            }
          },
          {
            "name": "desde",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-10-01",
              "type": "string"
            }
          },
          {
            "name": "hasta",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-10-31",
              "type": "string"
            }
          },
          {
            "name": "codigo",
            "required": false,
            "in": "query",
            "description": "Coincidencia parcial",
            "schema": {
              "example": "SRV-2026",
              "type": "string"
            }
          },
          {
            "name": "facturado",
            "required": false,
            "in": "query",
            "description": "false = completados pendientes de facturar",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "campo:asc|desc; campos: fecha, codigo, tarifa, distanciaKm, estado",
            "schema": {
              "example": "fecha:desc",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ data, total, page, limit, totalPages } con filtros combinables"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Servicios de transporte"
        ]
      },
